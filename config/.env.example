# Finnhub Economic Calendar API key
# Get one at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Production MT5 account (config/settings.py — the real $50K deployment)
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=your_broker_server

# Diagnostic MT5 account (config/settings_diagnostic.py — isolated $5K
# FundedNext plumbing test, NOT the production account above)
MT5_DIAGNOSTIC_LOGIN=your_diagnostic_account_number
MT5_DIAGNOSTIC_PASSWORD=your_diagnostic_password
MT5_DIAGNOSTIC_SERVER=your_diagnostic_broker_server

# Firebase Realtime Database URL (production — sync/firebase_push.py)
FIREBASE_DB_URL=your_firebase_db_url_here

# Optional: separate Firebase project/database for the diagnostic account's
# sync/firebase_push.py --config diagnostic. If left unset, diagnostic
# pushes fall back to FIREBASE_DB_URL above but namespaced under a
# "diagnostic/" path, so they still can't collide with production data.
FIREBASE_DB_URL_DIAGNOSTIC=
